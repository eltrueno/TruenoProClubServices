# Bot de Discord: anuncios de partidos, logros y equipo de la semana
TOKEN=

# Servicios del club
API_URL=https://api.casemuro.stream
WWW_URL=https://city.casemuro.stream

# Cuentas: de ahí sale el Discord de cada jugador para mencionarlo.
# El token se crea en accounts.casemuro.stream/admin (Tokens de API). Sin él, el bot
# funciona igual pero pone el nombre del jugador en vez de la mención.
AUTH_URL=https://auth.casemuro.stream
AUTH_API_TOKEN=

# Cola de eventos del worker
RABBITMQ_URL=amqp://user:pass@host:5672/vhost
