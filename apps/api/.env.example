PORT=80
DEVMODE=false
MONGO_URL=mongodb://127.0.0.1:27017/tpcs

# Club de FC27 (el clubId cambia con cada entrega)
CLUBID=
PLATFORM=common-gen5

# CORS: orígenes permitidos (coma-separados). En DEVMODE se acepta cualquiera.
ALLOWED_ORIGINS=https://www.casemurocity.org
# Servicio de auth: se reenvía la cookie a /api/auth/get-session para /admin y /members/me
AUTH_URL=https://auth.casemurocity.org

# Caché de /club: TTL y espera tras un fallo de EA
CLUB_CACHE_MS=3600000
CLUB_RETRY_MS=300000

# Fotos de jugadores en Cloudflare R2 (API S3). Sin esto el api funciona pero no se pueden subir fotos.
# R2_PUBLIC_URL: dominio público del bucket (p. ej. https://cdn.casemurocity.org)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

TOTW_CRON_SCHEDULE=0 21 * * 0
TZ=Europe/Madrid
PUPPETEER_EXECUTABLE_PATH=
