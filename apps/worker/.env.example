DEVMODE=false
MONGO_URL=mongodb://127.0.0.1:27017/tpcs
RABBITMQ_URL=amqp://localhost

# Club de FC27 (el clubId cambia con cada entrega)
CLUBID=
PLATFORM=common-gen5

WORKER_INTERVAL=300

# Logros de cuenta (comunes a todos los clubes): se guardan en la base compartida y los datos
# de cada cuenta (Discord, follow, sub) se piden al auth con un token de API, que se crea en
# accounts.casemuro.stream/admin. Sin token solo se evalúan los que dependen del juego.
SHARED_DB_NAME=tpcs27_shared
AUTH_URL=https://auth.casemuro.stream
AUTH_API_TOKEN=
FORCE_RECALCULATE=false
AVERAGE_MATCHES_THRESHOLD=

TOTW_CRON_SCHEDULE=0 21 * * 0
TOTW_MIN_GAMES_PLAYED=5
TOTW_MIN_GAMES_FLOOR=2
TOTW_MIN_GAMES_GOALKEEPER=1
TZ=Europe/Madrid
PUPPETEER_EXECUTABLE_PATH=
