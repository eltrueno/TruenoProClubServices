PORT=3001
DEVMODE=false
MONGODB_URI=mongodb://127.0.0.1:27017
DBNAME=auth

# Secreto de Better Auth (obligatorio en produccion): firma las sesiones y cifra los
# tokens de Twitch guardados. Generalo con `openssl rand -base64 32` y no lo cambies:
# si cambia, se cierran todas las sesiones y todos tendran que volver a conectar Twitch.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://auth.casemuro.stream
COOKIE_DOMAIN=.casemuro.stream
# Orígenes de confianza / CORS (coma-separados)
ALLOWED_ORIGINS=https://city.casemuro.stream,https://united.casemuro.stream

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_CHANNEL_ID=

# Sincronizacion de follow/sub/rol con Twitch (opcional)
# Cada cuantos minutos pasa el repaso en segundo plano
TWITCH_SYNC_INTERVAL_MINUTES=60
# A partir de cuantos minutos desde la ultima sincronizacion se consideran viejos los datos
TWITCH_SYNC_STALE_MINUTES=360
# Tras un intento fallido (p. ej. Twitch caido), minutos hasta reintentar en segundo plano
TWITCH_SYNC_RETRY_MINUTES=10
