---
import "../styles/global.css";
import Navbar from "../components/layout/Navbar.astro";
import Mainheader from "../components/layout/Mainheader.astro";
import Footer from "../components/layout/Footer.astro";
import { ClientRouter } from "astro:transitions";
import SeoHead from "../components/layout/SeoHead.astro";
import { CLUB } from "../config/club";
import type { BreadcrumbItem, JsonLd } from "../lib/structuredData";

interface Props {
	title: string;
	description: string;
	isindex: boolean;
	/** Migas de pan para Google: las páginas tras "Inicio", p. ej. [{ name: "Plantilla", path: "/plantilla" }] */
	breadcrumb?: BreadcrumbItem[];
	/** Datos estructurados propios de la página (ver lib/structuredData.ts) */
	jsonLd?: JsonLd[];
	/** Imagen para compartir de la página (ver pages/og/[page].png.ts) y su texto alternativo */
	ogImage?: string;
	ogImageAlt?: string;
}

const { title, isindex, description, breadcrumb, jsonLd, ogImage, ogImageAlt } = Astro.props;

// Variables del club por tema: colores de marca y, si el club los define, sus fondos (ver config/club.ts)
const c = CLUB.colors;
const themeVars = (theme: "light" | "dark") => {
	const s = CLUB.surfaces?.[theme];
	return [
		`--color-primary:${c.primary};`,
		`--color-primary-content:${c.primaryContent};`,
		`--color-secondary:${c.secondary};`,
		`--color-secondary-content:${c.secondaryContent};`,
		s?.base100 && `--color-base-100:${s.base100};`,
		s?.base200 && `--color-base-200:${s.base200};`,
		s?.base300 && `--color-base-300:${s.base300};`,
		s?.baseContent && `--color-base-content:${s.baseContent};`,
	].filter(Boolean).join("");
};
const clubThemeCss = `:root[data-theme="light"]{${themeVars("light")}}:root[data-theme="dark"]{${themeVars("dark")}}`;
---

<!doctype html>
<html lang="es" class="min-h-screen">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type={CLUB.logo.endsWith(".svg") ? "image/svg+xml" : "image/webp"} href={CLUB.logo} />
		<meta name="generator" content={Astro.generator} />
		<meta name="author" content="Raúl Jiménez 'el_trueno'" />
		<title>{title}</title>
		<SeoHead title={title} description={description} breadcrumb={breadcrumb} jsonLd={jsonLd} ogImage={ogImage} ogImageAlt={ogImageAlt} />
		<ClientRouter />
		<script is:inline>
			const applyTheme = () => {
				const theme = localStorage.getItem('theme') || 'system';
				const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
				
				document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
			};

			applyTheme();
			
			// Escuchar cambios en el sistema si el modo es 'system'
			window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
				if (localStorage.getItem('theme') === 'system' || !localStorage.getItem('theme')) {
					applyTheme();
				}
			});

			document.addEventListener('astro:after-swap', applyTheme);
		</script>

		<meta name="theme-color" content={CLUB.themeColor} />
		<meta name="color-scheme" content="dark light" />

		<!-- Colores de marca del club sobre los temas de global.css: club.ts es la
		     única fuente de verdad, así cada build sale con los suyos. La
		     especificidad de :root[data-theme] gana a la que genera DaisyUI. -->
		<style set:html={clubThemeCss}></style>

		<slot name="metadata" />
	</head>
	<body class="min-h-screen bg-base-100 dark:bg-base-300 text-base-content transition-colors duration-300 flex flex-col">
		{isindex && <Mainheader />}
		<Navbar isindex={isindex} />
		<main class="flex-1 w-full max-w-[100rem] 4xl:max-w-[112rem] 5xl:max-w-[125rem] mx-auto">
			<!-- Sin JS solo se ve un resumen (ver lib/buildData.ts): por si es una persona, que sepa por qué -->
			<noscript>
				<div role="alert" class="alert alert-warning mx-4 mt-4 lg:mx-8">
					<span>
						<strong>Activa JavaScript</strong> para ver la web completa: estadísticas, gráficas y filtros.
						Sin él solo verás un resumen.
					</span>
				</div>
			</noscript>
			<slot />
		</main>
		<Footer />
		<script>
			// Foto que vuela de la plantilla a la ficha del jugador al navegar (ver lib/playerPhotoTransition.ts)
			import { enablePlayerPhotoTransition } from "@/lib/playerPhotoTransition";
			enablePlayerPhotoTransition();
		</script>
	</body>
</html>
