---
import "../styles/global.css";
import Navbar from "../components/layout/Navbar.astro";
import Mainheader from "../components/layout/Mainheader.astro";
import Footer from "../components/layout/Footer.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
	title: string;
	description: string;
	keywords?: string;
	isindex: boolean;
}

const { title, isindex, description, keywords } = Astro.props;
---

<!doctype html>
<html lang="es" class="min-h-screen">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image" href="/logo.webp" />
		<meta name="generator" content={Astro.generator} />
		<meta name="author" content="Raúl Jiménez 'el_trueno'" />
		<meta name="description" content={description} />
		{keywords && <meta name="keywords" content={keywords} />}
		{!keywords && <meta name="keywords" content={title} />}
		<title>{title}</title>
		<ClientRouter />
		<script is:inline>
			const applyTheme = () => {
				const theme = localStorage.getItem('theme') || 'system';
				const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
				
				document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'light');
			};

			applyTheme();
			
			// Escuchar cambios en el sistema si el modo es 'system'
			window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
				if (localStorage.getItem('theme') === 'system' || !localStorage.getItem('theme')) {
					applyTheme();
				}
			});

			document.addEventListener('astro:after-swap', applyTheme);
		</script>

		<meta name="theme-color" content="#C80D0D" />
		<meta name="color-scheme" content="dark light" />

		<!-- Facebook Meta Tags -->
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<!-- Twitter Meta Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:domain" content="www.casemurocity.org" />
		<meta name="twitter:site" content="@elh_trueno" />
		<meta name="twitter:creator" content="@elh_trueno" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<slot name="metadata" />
	</head>
	<body class="min-h-screen bg-base-100 dark:bg-base-300 text-base-content transition-colors duration-300 flex flex-col">
		{isindex && <Mainheader />}
		<Navbar isindex={isindex} />
		<main class="flex-1 w-full max-w-[100rem] 4xl:max-w-[112rem] 5xl:max-w-[125rem] mx-auto">
			<slot />
		</main>
		<Footer />
	</body>
</html>
