---
/**
 * "Nuestra historia" de la portada: una línea de tiempo (pasos de config/club.ts + "Hoy" con los
 * datos del club en el build) y el objetivo en un banner sobre la foto del estadio.
 * Animaciones de scroll (scroll-driven, sin JS): la línea se dibuja al bajar, los pasos entran uno
 * tras otro y la foto hace parallax. Sin animation-timeline o con prefers-reduced-motion, estático.
 */
import { Picture } from "astro:assets";
import type { ClubStory } from "@/config/club";
import stadium from "@/assets/home/stadium.png";

interface Props {
	story: ClubStory;
	/** partidos oficiales y jugadores del club (del build); sin ellos, "Hoy" va sin cifras */
	gamesPlayed?: number | null;
	players?: number | null;
}

const { story, gamesPlayed, players } = Astro.props;

const today = {
	kicker: "Hoy",
	title: gamesPlayed ? `${gamesPlayed} partidos oficiales` : "Y seguimos",
	text: `${players ? `${players} jugadores han vestido la camiseta. ` : ""}Si buscas Clubes Pro de verdad, con buen ambiente y nivel, has llegado al lugar indicado.`,
};
const steps = [...story.steps, today];
---

<div>
	<ol class="story-steps relative grid gap-10 md:gap-6 mt-2" style={`--steps:${steps.length}`}>
		<!-- La línea que une los pasos (desde md): se dibuja de izquierda a derecha -->
		<div aria-hidden="true" class="story-line absolute bg-gradient-to-r from-primary/0 via-primary/70 to-primary/0"></div>
		{steps.map((step, i) => (
			<li class="story-step relative flex flex-col items-center text-center" style={`--i:${i}`}>
				<span class="story-dot relative z-10 size-10 rounded-full bg-primary text-primary-content font-black grid place-items-center ring-8 ring-base-100 dark:ring-base-300">
					{i + 1}
				</span>
				<span class="mt-4 text-xs uppercase font-black tracking-[0.25em] text-primary">{step.kicker}</span>
				<h3 class="mt-1 text-xl font-black tracking-tight">{step.title}</h3>
				<p class="mt-2 text-sm text-base-content/70 max-w-xs leading-relaxed">{step.text}</p>
			</li>
		))}
	</ol>

	<!-- Objetivo: banner con el estadio -->
	<div class="story-goal relative mt-14 overflow-hidden rounded-3xl min-h-80 lg:min-h-[26rem] flex items-end reveal-zoom">
		<Picture src={stadium} formats={["avif", "webp"]} widths={[640, 960, 1280, 1600]} sizes="(min-width: 1600px) 1500px, 100vw"
			alt="" loading="lazy" decoding="async" class="story-photo absolute inset-0 size-full object-cover" />
		<div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/55 to-black/10"></div>
		<div class="absolute inset-0 bg-gradient-to-r from-primary/45 to-transparent mix-blend-multiply"></div>
		<div class="story-goal-text relative p-6 lg:p-12 max-w-3xl text-white">
			<span class="flex items-center gap-3 text-xs uppercase font-black tracking-[0.3em] text-white/75">
				<span class="story-goal-rule h-px w-10 bg-white/60 origin-left"></span>
				{story.goal.kicker}
			</span>
			<h3 class="mt-3 text-3xl lg:text-5xl font-black tracking-tighter">{story.goal.title}</h3>
			<p class="mt-4 text-sm lg:text-base text-white/80 leading-relaxed">{story.goal.text}</p>
		</div>
	</div>
</div>

<style>
	/* Pasos: en columna en móvil; en fila desde md, unidos por una línea que va de círculo a círculo */
	.story-steps {
		grid-template-columns: 1fr;
	}
	.story-line {
		display: none;
	}
	@media (min-width: 768px) {
		.story-steps {
			grid-template-columns: repeat(var(--steps), minmax(0, 1fr));
		}
		.story-line {
			display: block;
			left: calc(50% / var(--steps));
			right: calc(50% / var(--steps));
			top: 1.25rem;
			height: 2px;
			transform-origin: left;
		}
	}

	@keyframes story-draw-x {
		from { scale: 0 1; }
		to { scale: 1 1; }
	}
	@keyframes story-step-in {
		from { opacity: 0; translate: 0 2rem; }
		to { opacity: 1; translate: 0 0; }
	}
	@keyframes story-dot-pop {
		from { scale: 0.4; opacity: 0; }
		70% { scale: 1.12; opacity: 1; }
		to { scale: 1; opacity: 1; }
	}
	@keyframes story-photo-pan {
		from { translate: 0 -7%; }
		to { translate: 0 7%; }
	}
	@keyframes story-rule-grow {
		from { scale: 0 1; }
		to { scale: 1 1; }
	}

	@supports (animation-timeline: view()) {
		@media (prefers-reduced-motion: no-preference) {
			/* Cada paso entra con su propio scroll (en móvil van uno debajo de otro) */
			.story-step {
				animation: story-step-in linear both;
				animation-timeline: view();
				animation-range: entry 10% cover 30%;
			}
			.story-dot {
				animation: story-dot-pop linear both;
				animation-timeline: view();
				animation-range: entry 20% cover 32%;
			}
			/* En fila (md): la línea se dibuja mientras la fila sube y los pasos entran uno tras otro */
			@media (min-width: 768px) {
				.story-steps {
					view-timeline: --story-steps block;
				}
				.story-line {
					animation: story-draw-x linear both;
					animation-timeline: --story-steps;
					animation-range: entry 30% cover 40%;
				}
				.story-step {
					animation-timeline: --story-steps;
					animation-range: entry calc(10% + var(--i) * 15%) cover calc(28% + var(--i) * 6%);
				}
				.story-dot {
					animation-timeline: --story-steps;
					animation-range: entry calc(20% + var(--i) * 15%) cover calc(30% + var(--i) * 6%);
				}
			}
			/* La foto del estadio se mueve más despacio que la página (y un poco ampliada para no ver
			   bordes). Se mide con el banner y no con la foto: el banner recorta (overflow hidden), así que
			   es su propio contenedor de scroll y view() en la foto no avanzaría nunca.
			   :global porque la <img> la pinta <Picture> y no lleva el atributo de este componente */
			.story-goal {
				view-timeline: --story-goal block;
			}
			.story-goal :global(.story-photo) {
				scale: 1.18;
				animation: story-photo-pan linear both;
				animation-timeline: --story-goal;
				animation-range: cover 0% cover 100%;
			}
			.story-goal-rule {
				animation: story-rule-grow linear both;
				animation-timeline: --story-goal;
				animation-range: entry 60% cover 40%;
			}
		}
	}
</style>
