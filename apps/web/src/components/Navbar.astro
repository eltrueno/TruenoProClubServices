---
import NavbarAccount from './auth/NavbarAccount.vue';

interface Props {
	isindex: boolean;
}

const {isindex} = Astro.props;
---

<nav class="navbar bg-primary min-w-full sticky top-0 rounded-b-md shadow-md z-50">
	<div class="flex-1 flex-grow-0">
		<a href="/" class="btn btn-ghost text-xl" aria-label="Volver al inicio de la página"><img src="/logo.webp" class="max-h-12" class:list={[{ 'logo-anim': isindex }]} alt="Logo del equipo CaseMuroCity"></img> </a>
	</div>
	<div class="space-x-1 absolute text-[#eeeeee]" class:list={[{ 'links-anim': isindex },{'right-16': !isindex}]}>
		<a href="/" class="btn btn-ghost hidden md:inline-flex uppercase" aria-label="Volver al inicio de la página"><span>Inicio</span></a>
		<a href="/plantilla" class="btn btn-ghost uppercase" aria-label="Ver plantilla del equipo CaseMuroCity"><span>Plantilla</span></a>
		<a href="/partidos" class="btn btn-ghost uppercase" aria-label="Ver partidos del equipo CaseMuroCity"><span>Partidos</span></a>
		<a href="/totw" class="btn btn-ghost uppercase" aria-label="Ver Team Of The Week del equipo CaseMuroCity"><span>Totw</span></a>
	</div>
	<div class="ml-auto z-10">
		<NavbarAccount client:load />
	</div>
</nav>



<style>

@media only screen and (min-width: 1024px){
	:root {
		--navbar-anim-start: 15vh;
		--navbar-anim-end: 20vh;
	}
}

@keyframes fade-logo {
	from {opacity: 0;}
	to {
		opacity: 1;
	}
}

@keyframes links {
	from{
		right: 50%;
		translate: 50%;
	}
	to{
		right: 4rem;
	}
}
:root{
	--navbar-anim-start: 13vh;
	--navbar-anim-end: 25vh;
}
.logo-anim {
	animation: fade-logo linear both;
	animation-timeline: scroll();
	animation-range: var(--navbar-anim-start) var(--navbar-anim-end);
}

.links-anim{
	animation: links linear both;
	animation-timeline: scroll();
	animation-range: var(--navbar-anim-start) var(--navbar-anim-end);
}
</style>
  