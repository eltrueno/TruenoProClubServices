---
import NavbarAccount from './auth/NavbarAccount.vue';
import { Icon } from "astro-icon/components";

interface Props {
	isindex: boolean;
}

const {isindex} = Astro.props;
---

<nav class="navbar bg-primary min-w-full sticky top-0 rounded-b-md shadow-md z-50">
	<div class="flex-1 flex-grow-0">
		<a href="/" class="btn btn-ghost text-xl" aria-label="Volver al inicio de la página"><img src="/logo.webp" class="max-h-12" class:list={[{ 'logo-anim': isindex }]} alt="Logo del equipo CaseMuroCity"></img> </a>
	</div>
	<div class="space-x-1 absolute text-[#eeeeee]" class:list={[{ 'links-anim': isindex },{'right-[var(--links-right)]': !isindex}]}>
		<a href="/" class="btn btn-ghost hidden md:inline-flex uppercase" aria-label="Volver al inicio de la página"><Icon name="home" class="w-6 h-6" /><span class="hidden md:inline">Inicio</span></a>
		<a href="/plantilla" class="btn btn-ghost uppercase" aria-label="Ver plantilla del equipo CaseMuroCity"><Icon name="usersgroup" class="w-6 h-6" /><span class="hidden md:inline">Plantilla</span></a>
		<a href="/partidos" class="btn btn-ghost uppercase" aria-label="Ver partidos del equipo CaseMuroCity"><Icon name="calendar" class="w-6 h-6" /><span class="hidden md:inline">Partidos</span></a>
		<a href="/totw" class="btn btn-ghost uppercase" aria-label="Ver Team Of The Week del equipo CaseMuroCity"><Icon name="award" class="w-6 h-6" /><span class="hidden md:inline">Totw</span></a>
	</div>
	<div class="ml-auto z-10">
		<NavbarAccount client:load />
	</div>
</nav>



<style>

:root {
	--links-right: 3.5rem;
}

@media (min-width: 640px) {
	:root {
		--links-right: 8rem;
	}
}

@media only screen and (min-width: 1024px){
	:root {
		--navbar-anim-start: 15vh;
		--navbar-anim-end: 20vh;
	}
}

@keyframes fade-logo {
	from {opacity: 0;}
	to {
		opacity: 1;
	}
}

@keyframes links {
	from{
		right: 50%;
		translate: 50%;
	}
	to{
		right: var(--links-right);
	}
}
:root{
	--navbar-anim-start: 13vh;
	--navbar-anim-end: 25vh;
}
.logo-anim {
	animation: fade-logo linear both;
	animation-timeline: scroll();
	animation-range: var(--navbar-anim-start) var(--navbar-anim-end);
}

.links-anim{
	animation: links linear both;
	animation-timeline: scroll();
	animation-range: var(--navbar-anim-start) var(--navbar-anim-end);
}
</style>
  