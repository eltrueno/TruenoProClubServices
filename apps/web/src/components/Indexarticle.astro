---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	reverse: boolean;
    id: string;
    gradientText: String;
    /** Imagen de src/assets: sale en AVIF/WebP, a varios tamaños y con su ancho y alto (sin saltos al cargar) */
    image: ImageMetadata;
}

const {reverse,id, gradientText, image} = Astro.props;

---
<div id={id} class="flex flex-wrap  p-6 md:p-10 lg:p-12 justify-center items-center"  class:list={[{ 'flex-row-reverse': reverse },{'flex-row': !reverse}]}>
    <div class="p-8 basis-3/3 md:basis-2/3 bg-base-200 dark:shadow rounded-xl shadow-lg h-fit" class:list={[{'reveal-left':!reverse},{'reveal-right':reverse}]}>
        <article>
            <header>
                <h2 class="text-5xl font-bold text-transparent bg-clip-text inline-block py-2"
                class:list={gradientText}>
                    <slot name="title"></slot>
                </h2>
            </header>
            <content>
                <p class="text-xl mt-6">
                    <slot></slot>
                </p>
            </content>
        </article>
    </div>
    <container class="flex basis-3/3 md:basis-1/3 mt-6 md:mt-0 justify-center">
        <!-- Decorativa: alt vacío. Ocupa ~1/3 del ancho en escritorio y casi todo en móvil -->
        <Picture src={image} formats={['avif', 'webp']} widths={[320, 480, 640, 800]} sizes="(min-width: 768px) 30vw, 90vw"
            class="parallax w-11/12 h-auto select-none pointer-events-none" alt="" loading="lazy" decoding="async" />
    </container>
</div>

<style>
    /* La tarjeta y la foto usan las utilidades .reveal-* de global.css */
</style>
