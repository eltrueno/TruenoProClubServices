---
import NavbarAccount from "../auth/NavbarAccount.vue";
import HomeIcon from "@/icons/home.svg";
import UsersIcon from "@/icons/usersgroup.svg";
import CalendarIcon from "@/icons/calendar.svg";
import AwardIcon from "@/icons/award.svg";

interface Props {
    isindex?: boolean;
}

const { isindex = false } = Astro.props;

const links = [
    { href: "/", label: "Inicio", icon: HomeIcon, aria: "Volver al inicio de la página", homeOnly: true },
    { href: "/plantilla", label: "Plantilla", icon: UsersIcon, aria: "Ver plantilla del Casemuro City" },
    { href: "/partidos", label: "Partidos", icon: CalendarIcon, aria: "Ver partidos del Casemuro City" },
    { href: "/totw", label: "Hall of Fame", icon: AwardIcon, aria: "Ver el Hall of Fame del Casemuro City" },
];

const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
const currentPath = normalize(Astro.url.pathname);
const isActive = (href: string) => href === currentPath;
---

<nav class="navbar bg-primary text-primary-content min-w-full sticky top-0 rounded-b-md shadow-md z-50">
    <div class="shrink-0">
        <a href="/" class="btn btn-ghost px-1" aria-label="Volver al inicio de la página">
            <img src="/logo.webp" class="h-12 w-auto" class:list={[{ "logo-anim": isindex }]} alt="Escudo del Casemuro City" />
        </a>
    </div>

    <div class="space-x-1 absolute" class:list={[{ "links-anim": isindex }, { "right-[var(--links-right)]": !isindex }]}>
        {links.map((link) => {
            const Icon = link.icon;
            return (
                <a
                    href={link.href}
                    class="btn btn-ghost uppercase"
                    class:list={[{ "hidden md:inline-flex": link.homeOnly, "nav-active": isActive(link.href) }]}
                    aria-label={link.aria}
                >
                    <Icon class="w-6 h-6" />
                    <span class="hidden md:inline">{link.label}</span>
                </a>
            );
        })}
    </div>

    <div id="navbar-account" class="ml-auto z-10" data-astro-prefetch="false">
        <NavbarAccount client:only="vue" />
    </div>
</nav>

<script>
    // Los enlaces van en absoluto (para la animación del index), así que la distancia a la derecha
    // se calcula con el ancho real del botón de cuenta para que nunca se solapen
    function placeLinks() {
        const account = document.getElementById("navbar-account");
        if (!account) return;
        const apply = () => document.documentElement.style.setProperty("--links-right", `${account.offsetWidth + 16}px`);
        apply();
        new ResizeObserver(apply).observe(account);
    }
    placeLinks();
    document.addEventListener("astro:after-swap", placeLinks);
</script>

<style>
    /* DaisyUI 5 pinta btn-ghost con base-content (negro en el tema claro): en la nav roja siempre blanco */
    .btn-ghost {
        --btn-fg: var(--color-primary-content);
        --btn-border: transparent;
        color: var(--color-primary-content);
    }
    .btn-ghost:hover {
        --btn-bg: color-mix(in oklab, var(--color-primary-content) 25%, transparent);
    }
    /* Página actual: fondo translúcido */
    .btn-ghost.nav-active {
        --btn-bg: color-mix(in oklab, var(--color-primary-content) 18%, transparent);
    }

    :root {
        --links-right: 3.5rem;
        --navbar-anim-start: 13vh;
        --navbar-anim-end: 25vh;
    }

    @media only screen and (min-width: 1024px) {
        :root {
            --navbar-anim-start: 15vh;
            --navbar-anim-end: 20vh;
        }
    }

    @keyframes fade-logo {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @keyframes links {
        from {
            right: 50%;
            translate: 50%;
        }
        to {
            right: var(--links-right);
        }
    }

    /* En el index el logo aparece y los enlaces se desplazan a la derecha conforme se oculta el escudo grande de la cabecera */
    .logo-anim {
        animation: fade-logo linear both;
        animation-timeline: scroll();
        animation-range: var(--navbar-anim-start) var(--navbar-anim-end);
    }

    .links-anim {
        animation: links linear both;
        animation-timeline: scroll();
        animation-range: var(--navbar-anim-start) var(--navbar-anim-end);
    }
</style>
