---
import NavbarAccount from "../auth/NavbarAccount.vue";
import HomeIcon from "@/icons/home.svg";
import UsersIcon from "@/icons/usersgroup.svg";
import CalendarIcon from "@/icons/calendar.svg";
import AwardIcon from "@/icons/award.svg";
import Separator from "./Separator.astro";
import { CLUB, OTHER_CLUBS } from "@/config/club";

interface Props {
    isindex?: boolean;
}

const { isindex = false } = Astro.props;

const links = [
    { href: "/", label: "Inicio", icon: HomeIcon, aria: "Volver al inicio de la página", homeOnly: true },
    { href: "/plantilla", label: "Plantilla", icon: UsersIcon, aria: `Ver plantilla de ${CLUB.name}` },
    { href: "/partidos", label: "Partidos", icon: CalendarIcon, aria: `Ver partidos de ${CLUB.name}` },
    { href: "/totw", label: "Salon de la fama", icon: AwardIcon, aria: `Ver el Hall of Fame de ${CLUB.name}` },
];

// En build estático con `format: "file"` la ruta llega como "/plantilla.html" (o "/index.html")
const normalize = (path: string) => path.replace(/\.html$/, "").replace(/\/index$/, "").replace(/\/+$/, "") || "/";
const currentPath = normalize(Astro.url.pathname);
const isActive = (href: string) => href === currentPath;

// Enlace a la web del otro club: su escudo asoma en pequeño en la esquina del nuestro (con dos clubes;
// si algún día hay más, aquí solo cabe uno y habría que pasar a un menú)
const otherClub = OTHER_CLUBS[0];

// Fondo de la nav según el club: su color principal o el del tema (ver headerStyle). Sobre el fondo del
// tema se despega de la página con un tono más marcado (más oscuro en claro, más claro en oscuro)
// y una línea del color del club debajo
const isBase = CLUB.headerStyle === "base";
const navTheme = isBase ? "nav-base bg-base-300 dark:bg-base-100 text-base-content" : "nav-primary bg-primary text-primary-content";
---

<nav class:list={["navbar min-w-full sticky top-0 rounded-b-md shadow-md z-50", navTheme]}>
    <!-- Escudo sobre disco blanco (se despega de cualquier fondo de nav: rojo, marfil u oscuro) y, en su
         esquina, el del otro club enlazando a su web. La animación del index va en el conjunto -->
    <div class="club-logo shrink-0 relative" class:list={[{ "logo-anim": isindex }]}>
        <!-- Tooltips de DaisyUI en un envoltorio: usan ::before/::after, que en la insignia ya amplía la zona de toque.
             tooltip-start: alineados a la izquierda, porque centrados se salían por el borde de la pantalla -->
        <div class="tooltip tooltip-bottom tooltip-start" data-tip={`Inicio de ${CLUB.name}`}>
            <a href="/" class="club-disc" aria-label="Volver al inicio de la página">
                <img src={CLUB.logo} class="h-10 w-auto" alt={`Escudo de ${CLUB.name}`} />
            </a>
        </div>
        {otherClub && (
            <div class="club-switch tooltip tooltip-bottom tooltip-start" data-tip={`Ir a la web de ${otherClub.name}`}>
                <a href={otherClub.webUrl} class="club-switch-link" aria-label={`Ir a la web de ${otherClub.name}`}>
                    <img src={otherClub.logo} alt="" class="h-[18px] w-auto" />
                </a>
            </div>
        )}
    </div>

    <!-- w-max + nowrap: al ir en absoluto (y en el index centrado con right:50%) solo tendría media pantalla
         de ancho disponible y el último botón saltaba de línea por debajo de la nav -->
    <div id="navbar-links" class="space-x-1 absolute w-max flex flex-nowrap" class:list={[{ "links-anim": isindex }, { "right-(--links-right)": !isindex }]}>
        {links.map((link) => {
            const Icon = link.icon;
            return (
                <a
                    href={link.href}
                    class="btn btn-ghost uppercase"
                    class:list={[{ "hidden md:inline-flex": link.homeOnly, "nav-active": isActive(link.href) }]}
                    aria-label={link.aria}
                >
                    <Icon class="w-6 h-6" />
                    <!-- Texto desde lg: con los cuatro en una línea, por debajo de ~880px pisarían el botón de cuenta -->
                    <span class="hidden lg:inline">{link.label}</span>
                </a>
            );
        })}
    </div>

    <div id="navbar-account" class="ml-auto z-10" data-astro-prefetch="false">
        <NavbarAccount client:only="vue" />
    </div>

    {isBase && <div class="absolute inset-x-0 bottom-0 pointer-events-none"><Separator height="h-[2px]" /></div>}
</nav>

<script>
    // Los enlaces van en absoluto (para la animación del index), así que la distancia a la derecha
    // se calcula con el ancho real del botón de cuenta para que nunca se solapen
    function placeLinks() {
        const account = document.getElementById("navbar-account");
        if (!account) return;
        const apply = () => document.documentElement.style.setProperty("--links-right", `${account.offsetWidth + 16}px`);
        apply();
        new ResizeObserver(apply).observe(account);
    }
    placeLinks();
    document.addEventListener("astro:after-swap", placeLinks);

    // Sección activa en cliente: cubre las páginas hijas (/jugador -> Plantilla, /partido -> Partidos)
    const SECTION_OF: Record<string, string> = { "/jugador": "/plantilla", "/partido": "/partidos", "/logrosdef": "/totw" };
    function markActive() {
        const path = location.pathname.replace(/\.html$/, "").replace(/\/+$/, "") || "/";
        const section = SECTION_OF[path] ?? path;
        document.querySelectorAll<HTMLAnchorElement>("#navbar-links a[href]").forEach((a) => {
            a.classList.toggle("nav-active", a.getAttribute("href") === section);
        });
    }
    markActive();
    document.addEventListener("astro:page-load", markActive);
</script>

<style>
    /* Colores de los botones según el fondo de la nav (headerStyle en config/club.ts) */
    .nav-primary {
        --nav-fg: var(--color-primary-content);
        --nav-hover: color-mix(in oklab, var(--color-primary-content) 25%, transparent);
        --nav-active-bg: color-mix(in oklab, var(--color-primary-content) 18%, transparent);
        --nav-active-fg: var(--color-primary-content);
    }
    /* Sobre el fondo del tema la sección actual se marca con el color del club */
    .nav-base {
        --nav-fg: var(--color-base-content);
        --nav-hover: color-mix(in oklab, var(--color-base-content) 10%, transparent);
        --nav-active-bg: var(--color-primary);
        --nav-active-fg: var(--color-primary-content);
    }

    /* DaisyUI 5 pinta btn-ghost con base-content (negro en el tema claro): aquí manda la nav */
    .btn-ghost {
        --btn-fg: var(--nav-fg);
        --btn-border: transparent;
        color: var(--nav-fg);
    }
    .btn-ghost:hover {
        --btn-bg: var(--nav-hover);
    }
    /* Página actual */
    .btn-ghost.nav-active {
        --btn-bg: var(--nav-active-bg);
        --btn-fg: var(--nav-active-fg);
        color: var(--nav-active-fg);
    }

    /* Disco blanco detrás de nuestro escudo: se lee igual sobre el rojo, el marfil o el oscuro */
    .club-disc {
        display: grid;
        place-items: center;
        width: 3.25rem;
        height: 3.25rem;
        border-radius: 9999px;
        background: #fff;
        box-shadow: 0 1px 4px rgb(0 0 0 / 0.25);
        transition: scale 0.2s ease;
    }
    .club-disc:hover,
    .club-disc:focus-visible {
        scale: 1.05;
    }

    /* Escudo del otro club: insignia blanca pequeña que solapa solo la esquina superior derecha del disco.
       El envoltorio (.club-switch) la coloca y lleva el tooltip (debajo: a la derecha quedaba por detrás
       de los botones de la nav); el enlace es la insignia. Algo separada del borde de arriba para que al
       crecer con el hover no se corte */
    .club-switch {
        position: absolute;
        right: -0.5rem;
        top: 0.15rem;
        z-index: 10;
    }
    .club-switch-link {
        position: relative;
        display: grid;
        place-items: center;
        width: 1.625rem;
        height: 1.625rem;
        border-radius: 9999px;
        background: #fff;
        box-shadow: 0 0 0 1.5px rgb(0 0 0 / 0.12), 0 1px 3px rgb(0 0 0 / 0.3);
        transition: scale 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), translate 0.25s ease;
    }
    .club-switch-link:hover,
    .club-switch-link:focus-visible {
        scale: 1.4;
        translate: 0.15rem 0;
    }
    /* Zona de toque más grande que la insignia (móvil) */
    .club-switch-link::before {
        content: "";
        position: absolute;
        inset: -0.4rem;
    }

    :root {
        --links-right: 3.5rem;
        --navbar-anim-start: 13vh;
        --navbar-anim-end: 25vh;
    }

    @media only screen and (min-width: 1024px) {
        :root {
            --navbar-anim-start: 15vh;
            --navbar-anim-end: 20vh;
        }
    }

    @keyframes fade-logo {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @keyframes links {
        from {
            right: 50%;
            translate: 50%;
        }
        to {
            right: var(--links-right);
        }
    }

    /* En el index el logo aparece y los enlaces se desplazan a la derecha conforme se oculta el escudo grande de la cabecera */
    .logo-anim {
        animation: fade-logo linear both;
        animation-timeline: scroll();
        animation-range: var(--navbar-anim-start) var(--navbar-anim-end);
    }

    .links-anim {
        animation: links linear both;
        animation-timeline: scroll();
        animation-range: var(--navbar-anim-start) var(--navbar-anim-end);
    }
</style>
