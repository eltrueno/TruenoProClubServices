---
---

<header class="p-6 bg-primary text-primary-content">
    <div class="flex flex-col justify-center items-center px-6">
        <img src="/logo.webp" class="w-1/4 md:w-1/12 escudo" alt="Escudo del Casemuro City" />
    </div>
    <p class="text-3xl mt-4 font-bold text-center uppercase">Casemuro City</p>
</header>

<style>
    :root {
        --logoheader-anim-start: 0px;
        --logoheader-anim-end: 16vh;
    }

    @media only screen and (min-width: 1024px) {
        .escudo {
            --logoheader-anim-start: 0px;
            --logoheader-anim-end: 18vh;
        }
    }

    @keyframes hide-escudo {
        to {
            opacity: 0;
            translate: -50vw 200px;
            scale: 0.5;
        }
    }

    /* El escudo se encoge y se va hacia el logo de la navbar al hacer scroll */
    .escudo {
        animation: hide-escudo linear both;
        animation-timeline: scroll(nearest);
        animation-range: var(--logoheader-anim-start) var(--logoheader-anim-end);
    }
</style>
