---
import MatchesContainer from "@/components/match/MatchesContainer.vue";
import Layout from "@layouts/Layout.astro";
import { CLUB } from "@/config/club";

// Filtros por query (?id, ?desde, ?hasta, ?liga, ?playoff, ?amistoso): los lee MatchesContainer en cliente
---

<Layout
	title={`${CLUB.name}: Partidos`}
	isindex={false}
	description="Historial y estadísticas de nuestros últimos partidos"
	keywords={[...CLUB.keywords, "fifa", "eafc", "fifa23", "fifa24", "eafc24", "club", "pro", "clubespro", "proclubs", "inicio", "partidos", "estadísticas", "stats"].join(", ")}
>

	<header class="container mx-auto mb-10">
		<h1 class="text-primary font-bold text-3xl text-center mt-8 p-8">
			Partidos
		</h1>
		<h2 class="font-bold text-2xl text-center">
			Aquí se muestra el historial de nuestros últimos partidos
		</h2>
	</header>
	<section>
		<container class="flex px-2 py-4 justify-center items-center">
			<MatchesContainer client:only="vue" />
		</container>
	</section>
</Layout>
