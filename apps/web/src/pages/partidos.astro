---
import MatchesContainer from "@/components/match/MatchesContainer.vue";
import Layout from "@layouts/Layout.astro";
import PageHeader from "@components/layout/PageHeader.astro";
import { CLUB } from "@/config/club";
import MatchesSummary from "@components/seo/MatchesSummary.astro";
import { buildLatestMatches } from "@/lib/buildData";

// Resumen para quien no ejecuta JS, con los datos del build (ver lib/buildData.ts)
const latestMatches = await buildLatestMatches(20);

// /partidos?q=&tipo=liga,playoff,amistoso&jugadores=&desde=&hasta=&min=&pagina= (los lee MatchesContainer en cliente;
// también los de antes: ?id, ?liga, ?playoff, ?amistoso, ?player)
const crumbs = [{ name: "Partidos", path: "/partidos" }];
---

<Layout
	title={`Partidos de ${CLUB.name} · Resultados y estadísticas`}
	isindex={false}
	description={`Resultados e historial de partidos de ${CLUB.name} en Clubes Pro de EA SPORTS FC: liga, playoffs y amistosos, con las estadísticas de cada jugador.`}
	breadcrumb={crumbs}
	ogImage="/og/partidos.png"
	ogImageAlt={`Partidos de ${CLUB.name}`}
>

	<div class="w-full max-w-[90rem] mx-auto px-4 lg:px-8 py-8 lg:py-12 flex flex-col gap-6">
		<PageHeader title="Partidos" crumbs={crumbs} />

		<div id="matches-app">
			<MatchesContainer client:only="vue">
				<!-- Mientras carga el componente: el mismo hueco que la lista -->
				<div slot="fallback" class="flex flex-col gap-3" aria-busy="true">
					<div class="skeleton h-14 w-full rounded-2xl"></div>
					<div class="skeleton h-24 w-full rounded-2xl"></div>
					{Array.from({ length: 6 }, () => <div class="skeleton h-20 w-full rounded-2xl"></div>)}
				</div>
			</MatchesContainer>
		</div>
		<!-- Sin JS: fuera la lista (se quedaría cargando) y en su lugar el resumen -->
		<noscript>
			<style>#matches-app { display: none; }</style>
			<MatchesSummary matches={latestMatches} />
		</noscript>
	</div>
</Layout>
