---
export const prerender = false;
import Layout from "@/layouts/Layout.astro";
import MatchDetail from "@/components/match/detail/MatchDetail.vue";
import MatchDetailSkeleton from "@/components/match/detail/MatchDetailSkeleton.vue";

const { matchid } = Astro.params;
const selectedPlayer = Astro.url.searchParams.get('player');

if (matchid == undefined) {
	return Astro.redirect("/partidos");
}
---

<Layout
	title="Casemuro City: Detalles de Partido"
	isindex={false}
	description="Detalles del partido"
	keywords="fifa, eafc, fifa23, fifa24, eafc24, club, pro, clubespro, proclubs, casemurocity, eltrueno, el_trueno, inicio, partido, stats, detalles, detail, casemuro, mrcasemuro, mr_casemuro"
>
	<meta
		slot="metadata"
		property="og:url"
		content={`https://www.casemurocity.org/partido/${matchid}`}
	/>
	<meta
		slot="metadata"
		property="og:image"
		content="https://www.casemurocity.org/escudo_banner_fondo.webp"
	/>
	<meta
		slot="metadata"
		name="twitter:url"
		content={`https://www.casemurocity.org/partido/${matchid}`}
	/>
	<meta
		slot="metadata"
		name="twitter:image"
		content="https://www.casemurocity.org/escudo_banner_fondo.webp"
	/>

	<meta slot="metadata" name="robots" content="noindex, nofollow" />

	<section>
		<container class="flex px-2 py-4 justify-center items-center text-center">
			<MatchDetail client:only="vue" matchId={Number(matchid)} playerName={selectedPlayer ?? ""}>
                <MatchDetailSkeleton slot="fallback" />
            </MatchDetail>
		</container>
	</section>
</Layout>
