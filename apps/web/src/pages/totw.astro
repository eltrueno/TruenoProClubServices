---
import Layout from "@layouts/Layout.astro";
import { CLUB, OTHER_CLUBS } from "@/config/club";
import DerbyTotwTeaser from "@components/totw/DerbyTotwTeaser.astro";

// El TOTW de siempre está desactivado: vuelve como "TOTW del derbi" (solo partidos City vs United).
// Mientras, solo un "Próximamente". El de antes sigue en components/totw/TotwContainer.vue
// (con /totw?semana=…&tipo=…), listo para volver a usarlo.
---

<Layout
    title={`TOTW del derbi · ${CLUB.name}`}
    isindex={false}
    description={`Próximamente: el equipo de la semana de ${CLUB.name} contando solo los derbis contra ${OTHER_CLUBS[0]?.name ?? "el otro club de la comunidad"}. Un once mixto con lo mejor de los dos clubes.`}
    breadcrumb={[{ name: "TOTW", path: "/totw" }]}
    ogImage="/og/totw.png"
    ogImageAlt={`TOTW del derbi de ${CLUB.name}`}
>
    <DerbyTotwTeaser />
</Layout>
