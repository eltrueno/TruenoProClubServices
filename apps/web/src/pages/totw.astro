---
import TotwContainer from "@components/totw/TotwContainer.vue";
import Layout from "@layouts/Layout.astro";
import { CLUB } from "@/config/club";

// /totw?semana=<iso>&tipo=best|worst — lo lee TotwContainer en cliente
---

<Layout
    title={`${CLUB.name}: Equipo de la semana`}
    isindex={false}
    description="Mejores y peores jugadores de la semana"
    keywords={[...CLUB.keywords, "fifa", "eafc", "fifa23", "fifa24", "eafc24", "club", "pro", "clubespro", "proclubs", "inicio", "plantilla", "jugadores", "totw", "mejores", "peores", "semana"].join(", ")}
>
    <section>
        <container class="flex px-2 py-4 justify-center items-center">
            <TotwContainer client:only="vue" />
        </container>
    </section>
</Layout>
