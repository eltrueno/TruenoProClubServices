---
import Layout from "@layouts/Layout.astro";
import PlayersContainer from "@components/player/PlayersContainer.vue";
import { CLUB } from "@/config/club";
import RosterSummary from "@components/seo/RosterSummary.astro";
import { buildRoster } from "@/lib/buildData";

// Resumen para quien no ejecuta JS, con los datos del build (ver lib/buildData.ts)
const roster = await buildRoster();
// /plantilla?id=<playerId> abre el detalle de ese jugador (se lee en cliente)
---

<Layout
	title={`Plantilla de ${CLUB.name} · Jugadores y estadísticas`}
	isindex={false}
	description={`Todos los jugadores de ${CLUB.name} en Clubes Pro de EA SPORTS FC: posiciones, partidos, goles, asistencias y valoraciones, actualizados tras cada partido.`}
	breadcrumb={[{ name: "Plantilla", path: "/plantilla" }]}
	ogImage="/og/plantilla.png"
	ogImageAlt={`Plantilla de ${CLUB.name}`}
>

	<header class="container mx-auto mb-10">
		<h1 class="text-primary font-bold text-3xl text-center mt-8 p-8">
			LEYENDAS DEL CLUB🌟
		</h1>
		<p class="font-bold text-2xl text-center">
			Esta es nuestra plantilla, no intentes entenderlo, solo disfruta
		</p>
	</header>
	<section>
		<container id="squad-app" class="flex px-2 py-4 justify-center items-center">
			<PlayersContainer client:load />
		</container>
		<!-- Sin JS: fuera la plantilla de siempre (se quedaría vacía y cargando) y en su lugar el resumen -->
		<noscript>
			<style>#squad-app { display: none; }</style>
			<div class="px-4 py-4"><RosterSummary roster={roster} /></div>
		</noscript>
	</section>
</Layout>
