---
import Layout from "@layouts/Layout.astro";
import PlayersContainer from "@components/player/PlayersContainer.vue";
import { CLUB } from "@/config/club";
// /plantilla?id=<playerId> abre el detalle de ese jugador (se lee en cliente)
---

<Layout
	title={`${CLUB.name}: Plantilla`}
	isindex={false}
	description="Esta es nuestra plantilla, no intentes entenderlo, solo disfruta"
	keywords={[...CLUB.keywords, "fifa", "eafc", "fifa23", "fifa24", "eafc24", "club", "pro", "clubespro", "proclubs", "inicio", "plantilla", "jugadores"].join(", ")}
>

	<header class="container mx-auto mb-10">
		<h1 class="text-primary font-bold text-3xl text-center mt-8 p-8">
			LEYENDAS DEL CLUB🌟
		</h1>
		<h2 class="font-bold text-2xl text-center">
			Esta es nuestra plantilla, no intentes entenderlo, solo disfruta
		</h2>
	</header>
	<section>
		<container class="flex px-2 py-4 justify-center items-center">
			<PlayersContainer client:load />
		</container>
	</section>
</Layout>
