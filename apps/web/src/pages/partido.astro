---
import Layout from "@/layouts/Layout.astro";
import MatchDetail from "@/components/match/detail/MatchDetail.vue";
import MatchDetailSkeleton from "@/components/match/detail/MatchDetailSkeleton.vue";
import { CLUB } from "@/config/club";
// /partido?id=<matchId>&player=<playerId> — se leen en cliente
---

<Layout
	title={`${CLUB.name}: Detalles de Partido`}
	isindex={false}
	description="Detalles del partido"
	keywords={[...CLUB.keywords, "fifa", "eafc", "ea fc", "club", "pro", "clubespro", "proclubs", "partido", "stats", "detalles"].join(", ")}
>
	<meta slot="metadata" name="robots" content="noindex, nofollow" />

	<section>
		<container class="flex px-2 py-4 justify-center items-center text-center">
			<MatchDetail client:only="vue">
				<MatchDetailSkeleton slot="fallback" />
			</MatchDetail>
		</container>
	</section>
</Layout>
