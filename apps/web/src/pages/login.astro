---
import LoginWall from "@/components/auth/LoginWall.vue";
import Layout from "@/layouts/Layout.astro";
import { CLUB } from "@/config/club";
---

<Layout
	title={`${CLUB.name}: Inicio de sesión`}
	isindex={false}
	description={`Inicio de sesión en ${CLUB.name}`}
	keywords={[...CLUB.keywords, "fifa", "eafc", "fifa23", "fifa24", "eafc24", "club", "pro", "clubespro", "proclubs", "inicio", "jugador", "login", "cuenta"].join(", ")}
>
	<meta slot="metadata" name="robots" content="noindex, nofollow" />

	<section>
		<container class="flex p-4 lg:p-8 justify-center items-center text-center">
			<LoginWall client:load />
		</container>
	</section>
</Layout>