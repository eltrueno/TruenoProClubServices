---
import LoginWall from "@/components/auth/LoginWall.vue"
import Layout from "@/layouts/Layout.astro"
---

<Layout
	title="Casemuro City: Inicio de sesión"
	isindex={false}
	description="Inicio de sesión en Casemuro City"
	keywords="fifa, eafc, fifa23, fifa24, eafc24, club, pro, clubespro, proclubs, casemurocity, eltrueno, el_trueno, inicio, jugador, login, cuenta, casemuro, mrcasemuro, mr_casemuro"
>
	<meta
		slot="metadata"
		property="og:url"
		content={`https://www.casemurocity.org/login`}
	/>
	<meta
		slot="metadata"
		property="og:image"
		content="https://www.casemurocity.org/escudo_banner_fondo.webp"
	/>
	<meta
		slot="metadata"
		name="twitter:url"
		content={`https://www.casemurocity.org/login`}
	/>
	<meta
		slot="metadata"
		name="twitter:image"
		content="https://www.casemurocity.org/escudo_banner_fondo.webp"
	/>

	<meta slot="metadata" name="robots" content="noindex, nofollow" />

	<section>
		<container class="flex p-6 lg:p-12 justify-center items-center text-center">
			<LoginWall client:load />
		</container>
	</section>
</Layout>