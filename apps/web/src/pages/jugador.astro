---
import Layout from "@layouts/Layout.astro";
import PlayerDetail from "@components/player/detail/PlayerDetail.vue";
import PlayerDetailSkeleton from "@components/player/detail/PlayerDetailSkeleton.vue";
import { CLUB } from "@/config/club";
// /jugador?id=<playerId>&tab=stats|form|... — el id y la pestaña se leen en cliente
---

<Layout
	title={`${CLUB.name}: Perfil del jugador`}
	isindex={false}
	description="Perfil y detalles del jugador"
	keywords={[...CLUB.keywords, "fifa", "eafc", "ea fc", "club", "pro", "clubespro", "proclubs", "jugador", "stats", "detalles"].join(", ")}
>
	<meta slot="metadata" name="robots" content="noindex, nofollow" />

	<section>
		<container class="flex px-2 py-4 justify-center items-center text-center">
			<PlayerDetail client:only="vue">
				<PlayerDetailSkeleton slot="fallback" />
			</PlayerDetail>
		</container>
	</section>
</Layout>
