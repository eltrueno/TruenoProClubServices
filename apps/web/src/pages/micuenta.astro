---
import MyAccountPage from "@/components/auth/MyAccountPage.vue";
import Layout from "@/layouts/Layout.astro";
import { CLUB } from "@/config/club";
---

<Layout
	title={`${CLUB.name}: Mi Cuenta`}
	isindex={false}
	description={`Mi Cuenta en ${CLUB.name}`}
	keywords={[...CLUB.keywords, "fifa", "eafc", "fifa23", "fifa24", "eafc24", "club", "pro", "clubespro", "proclubs", "inicio", "jugador", "login", "cuenta", "micuenta"].join(", ")}
>
	<meta slot="metadata" name="robots" content="noindex, nofollow" />

	<section>
		<container class="flex px-2 py-4 justify-center items-center text-center">
			<MyAccountPage client:load />
		</container>
	</section>
</Layout>