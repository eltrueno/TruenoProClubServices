---
// Los ajustes de la cuenta viven en accounts.casemuro.stream (comunes a todos los clubes).
// Esta ruta se mantiene para no romper enlaces antiguos: redirige allí (conservando
// #mi-jugador y similares).
import { CLUB } from "@/config/club";
const target = `${CLUB.accountsUrl}/`;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="robots" content="noindex, nofollow" />
		<meta http-equiv="refresh" content={`0;url=${target}`} />
		<title>Mi cuenta · {CLUB.name}</title>
		<script is:inline define:vars={{ target }}>
			window.location.replace(target + window.location.hash);
		</script>
	</head>
	<body>
		<p>Tu cuenta está ahora en <a href={target}>{target}</a>.</p>
	</body>
</html>
