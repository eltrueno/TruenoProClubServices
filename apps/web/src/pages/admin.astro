---
import AdminPanel from "@/components/admin/AdminPanel.vue";
import Layout from "@/layouts/Layout.astro";
import { CLUB } from "@/config/club";
---

<Layout
	title={`${CLUB.name}: Admin`}
	isindex={false}
	description={`Panel de administración de ${CLUB.name}`}
	keywords={`${CLUB.name}, admin`}
>
	<meta slot="metadata" name="robots" content="noindex, nofollow" />

	<section>
		<container class="flex px-2 py-4 justify-center items-center text-center">
			<AdminPanel client:only="vue" />
		</container>
	</section>
</Layout>
