---
// El panel admin se ha movido a accounts (común a todos los clubes): /admin solo redirige allí
import { CLUB } from "@/config/club";
const target = `${CLUB.accountsUrl}/admin?club=${CLUB.id}`;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="robots" content="noindex, nofollow" />
		<meta http-equiv="refresh" content={`0; url=${target}`} />
		<link rel="canonical" href={target} />
		<title>Panel admin</title>
	</head>
	<body>
		<p>El panel admin está ahora en <a href={target}>{target}</a>.</p>
	</body>
</html>
