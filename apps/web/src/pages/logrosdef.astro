---
import Layout from '@layouts/Layout.astro';
import AchievementDefinitions from '@/components/achievements/AchievementDefinitions.vue';
import { CLUB } from '@/config/club';
---

<Layout
	title={`${CLUB.name}: Logros`}
	isindex={false}
	description="Esta es nuestra plantilla, no intentes entenderlo, solo disfruta"
	keywords={[...CLUB.keywords, "fifa", "eafc", "fifa23", "fifa24", "eafc24", "club", "pro", "clubespro", "proclubs", "inicio", "plantilla", "jugadores", "logros"].join(", ")}
>
	<section>
		<container class="flex p-6 lg:p-16 justify-center items-center">
			<AchievementDefinitions client:only />
		</container>
	</section>
</Layout>