---
import Indexarticle from "@components/Indexarticle.astro";
import Layout from "@layouts/Layout.astro";
import ClubStats from "@components/ClubStats.vue";
import ClubHighlights from "@components/home/ClubHighlights.vue";
import LastMatches from "@components/home/LastMatches.vue";
import ClubRecords from "@components/home/ClubRecords.vue";
import ClubPulse from "@components/home/ClubPulse.vue";
import SectionTitle from "@components/layout/SectionTitle.astro";
import { CLUB } from "@/config/club";
import ClubSummary from "@components/seo/ClubSummary.astro";
import MatchesSummary from "@components/seo/MatchesSummary.astro";
import { buildClub, buildLatestMatches } from "@/lib/buildData";

// Quién es el club, para Google: el equipo y la web
const sameAs = Object.values(CLUB.socials).filter(Boolean);
const homeJsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "SportsTeam",
		name: CLUB.name,
		url: `${CLUB.siteUrl}/`,
		logo: CLUB.logo.startsWith("http") ? CLUB.logo : `${CLUB.siteUrl}${CLUB.logo}`,
		sport: "EA SPORTS FC Clubes Pro",
		description: `Club de Clubes Pro de EA SPORTS FC de la comunidad de Mr Casemuro.`,
		...(sameAs.length ? { sameAs } : {}),
	},
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		name: CLUB.name,
		url: `${CLUB.siteUrl}/`,
		inLanguage: "es",
	},
];

// Resumen para quien no ejecuta JS, con los datos del build (ver lib/buildData.ts)
const [club, latestMatches] = await Promise.all([buildClub(), buildLatestMatches(5)]);
---

<Layout
	title={`${CLUB.name} · Club de Clubes Pro de EA SPORTS FC`}
	isindex
	description={`Web oficial de ${CLUB.name}, el club de Clubes Pro de EA SPORTS FC de la comunidad de Mr Casemuro: resultados, plantilla, estadísticas y récords al día.`}
	jsonLd={homeJsonLd}
>
	<!-- overflow-x-clip: las tarjetas que entran de lado (reveal-sides) no deben abrir scroll horizontal -->
	<div class="w-full max-w-[100rem] mx-auto px-4 lg:px-8 flex flex-col gap-12 lg:gap-16 py-8 lg:py-12 overflow-x-clip">
		<!-- Hero -->
		<header class="text-center reveal-stagger">
			<p class="text-xs lg:text-sm uppercase tracking-[0.3em] font-black text-primary">Web oficial</p>
			<h1 class="text-4xl lg:text-6xl font-black tracking-tighter mt-2">{CLUB.name}</h1>
			<p class="mt-4 text-base lg:text-lg text-base-content/70 max-w-2xl mx-auto leading-relaxed">
				El club de Clubes Pro de la comunidad de Mr Casemuro. Plantilla, partidos, estadísticas y logros,
				actualizados automáticamente después de cada partido.
			</p>
			<div class="mt-6 flex flex-wrap gap-3 justify-center items-center">
				<!-- aura: el anillo giratorio de DaisyUI 5, solo en la llamada principal -->
				<span class="aura aura-dual text-primary">
					<a href="/plantilla" class="btn btn-primary rounded-xl font-bold">Ver plantilla</a>
				</span>
				<a href="/partidos" class="btn btn-outline rounded-xl font-bold">Últimos partidos</a>
			</div>
		</header>

		<!-- Datos del club -->
		<section>
			<SectionTitle id="datos">Datos, no opiniones</SectionTitle>
			<ClubHighlights client:only="vue" />
			<noscript><ClubSummary club={club} /></noscript>
		</section>

		<!-- Último partido y jugador del momento -->
		<section>
			<LastMatches client:only="vue" />
			<noscript><MatchesSummary matches={latestMatches} title="Últimos partidos" /></noscript>
		</section>

		<!-- El club en datos -->
		<section>
			<SectionTitle>El club en cifras</SectionTitle>
			<ClubPulse client:only="vue" />
		</section>

		<!-- Récords del club -->
		<section>
			<SectionTitle>Récords del club</SectionTitle>
			<ClubRecords client:only="vue" />
		</section>

		<!-- Todos los números (stats completas de EA) -->
		<section>
			<SectionTitle>Todos los números</SectionTitle>
			<ClubStats client:only="vue" class="overflow-clip" />
		</section>
	</div>

	<!-- Historia del club: la de cada club, de config/club.ts (si no tiene, no sale) -->
	{CLUB.story && (
		<section class="overflow-x-clip">
			<Indexarticle
				id="origen"
				reverse={false}
				gradientText="bg-gradient-to-r from-pink-500 via-red-500 to-yellow-500"
				imageUrl="/origin.png"
			>
				<p slot="title">Origen</p>
				{CLUB.story.origin}
			</Indexarticle>
			<Indexarticle
				id="objetivo"
				reverse
				gradientText="bg-gradient-to-r from-rose-400 via-fuchsia-500 to-indigo-500"
				imageUrl="/stadium.png"
			>
				<p slot="title">Objetivo</p>
				{CLUB.story.goal}
			</Indexarticle>
		</section>
	)}

	<!-- CTA: vincular cuenta -->
	<section class="w-full max-w-[100rem] mx-auto px-4 lg:px-8 py-12 lg:py-16">
		<div class="reveal-zoom rounded-2xl bg-base-200 p-6 lg:p-10 flex flex-col lg:flex-row items-center gap-6 text-center lg:text-left">
			<div class="flex-1">
				<h2 class="text-2xl lg:text-3xl font-black tracking-tighter">¿Juegas en el club?</h2>
				<p class="mt-2 text-base-content/70 leading-relaxed">
					Vincula tu cuenta de Twitch con tu jugador y consulta tus estadísticas, tu progresión y tus logros.
				</p>
			</div>
			<a href={`${CLUB.accountsUrl}/#mi-jugador`} class="btn btn-primary rounded-xl font-bold">Vincular mi cuenta</a>
		</div>
	</section>
</Layout>
