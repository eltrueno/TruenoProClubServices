---
import TwitchIcon from "../icons/twitch.svg";
import YoutubeIcon from "../icons/youtube.svg";
import XIcon from "../icons/x.svg";
import InstagramIcon from "../icons/instagram.svg";
import TiktokIcon from "../icons/tiktok.svg";
import GithubIcon from "../icons/github.svg";
import HeartIcon from "../icons/heart.svg";
import { BRAND_CLUBS, CASEMURO_SOCIALS, DEV_SOCIALS } from "../config/site";

interface Props {
	/** en el login: solo la banda, la privacidad y los créditos */
	compact?: boolean;
}
const { compact = false } = Astro.props;

const ICONS = { twitch: TwitchIcon, youtube: YoutubeIcon, x: XIcon, instagram: InstagramIcon, tiktok: TiktokIcon, github: GithubIcon } as const;
const year = new Date().getFullYear();

const people = [
	{
		title: "La comunidad",
		name: "Mr Casemuro",
		text: "El portero de Clubes Pro. Detrás de cada club, cada directo y cada partido.",
		socials: CASEMURO_SOCIALS,
	},
	{
		title: "Partner técnico",
		name: "el_trueno",
		text: "Desarrollo de las webs, las cuentas, la sincronización con EA y los bots.",
		socials: DEV_SOCIALS,
	},
];
---

<!-- Superficie elevada como las tarjetas, con la banda de marca arriba -->
<footer class:list={["bg-base-200", compact ? "mt-8" : "mt-12"]}>
	<div class="h-1.5 bg-brand"></div>

	<div class:list={["w-full max-w-3xl mx-auto px-4 sm:px-6 pb-6", compact ? "pt-6" : "pt-10"]}>
		{!compact && (
		<div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.3fr_1fr_1fr]">
			<!-- Marca y clubes -->
			<section class="sm:col-span-2 lg:col-span-1">
				<div class="w-fit">
					<div class="text-lg font-black tracking-tight uppercase text-brand">Casemuro</div>
					<div class="h-[2px] bg-brand mt-1"></div>
					<div class="text-[11px] font-bold uppercase tracking-[0.2em] text-base-content/60 mt-1">Mi cuenta</div>
				</div>
				<p class="mt-4 text-sm leading-relaxed text-base-content/60">
					Una sola cuenta para todas las webs de la comunidad de Mr Casemuro: tu perfil, tus conexiones y tu jugador.
				</p>
				<div class="mt-5 flex flex-col gap-2">
					<span class="text-[11px] uppercase tracking-widest font-black text-base-content/40">Webs de los clubes</span>
					{BRAND_CLUBS.map((club) => (
						<a href={club.webUrl} class="group inline-flex w-fit items-center gap-2 text-sm font-semibold text-base-content/70 hover:text-base-content transition-colors">
							<img src={club.logo} alt="" class="h-5 w-5 object-contain" loading="lazy" />
							{club.name}
							<span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
						</a>
					))}
				</div>
			</section>

			{people.map((p) => (
				<section>
					<h3 class="text-[11px] uppercase tracking-widest font-black text-brand w-fit">{p.title}</h3>
					<p class="mt-3 font-bold">{p.name}</p>
					<p class="mt-1 text-sm leading-relaxed text-base-content/60">{p.text}</p>
					<div class="mt-3 flex flex-wrap gap-1">
						{p.socials.map((s) => {
							const Icon = ICONS[s.id];
							return (
								<a
									href={s.href}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={`${p.name} en ${s.label}`}
									title={s.label}
									class="social btn btn-sm btn-circle btn-ghost text-base-content/60"
								>
									<Icon class="size-4" />
								</a>
							);
						})}
					</div>
				</section>
			))}
		</div>

		)}

		{!compact && <div class="my-8 h-px bg-base-content/10"></div>}

		<div class="flex flex-col gap-3 text-center text-xs text-base-content/50 sm:flex-row sm:items-center sm:justify-between sm:text-left">
			<div class="flex flex-col sm:flex-row gap-1 sm:gap-3 items-center">
				<span>© {year} Comunidad Casemuro</span>
				<span class="hidden sm:inline">·</span>
				<a href="/privacidad" class="hover:text-base-content transition-colors">Política de privacidad</a>
			</div>
			<div class="flex items-center justify-center gap-1">
				Hecho con mucho <HeartIcon class="size-3.5 text-primary animate-pulse" /> por
				<a href="https://github.com/eltrueno" class="font-bold text-brand">R. Jiménez (el_trueno)</a>
			</div>
		</div>
	</div>
</footer>

<style>
	/* Al pasar por encima, el icono se llena con el degradado de marca */
	.social:hover {
		background-image: var(--brand-gradient-strong);
		color: white;
		border-color: transparent;
	}
</style>
