# URL pública de esta web (canonical y vuelta del login de Twitch)
PUBLIC_SITE_URL=https://accounts.casemuro.stream

# Servicio de auth (Better Auth), común a todos los clubes
PUBLIC_AUTH_URL=https://auth.casemuro.stream

# Opcionales: api de cada club (por defecto, <web del club>/api). Útil en local.
# PUBLIC_API_URL_CITY=http://localhost:80
# PUBLIC_API_URL_UNITED=http://localhost:81
# PUBLIC_WEB_URL_CITY=http://localhost:4321
# PUBLIC_CLUBS=city
# Para probarlo todo en local de una vez: `pnpm dev:local` desde la raíz (ver scripts/dev-local.mjs)
