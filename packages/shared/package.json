{
  "name": "@trueno-proclub-services/shared",
  "version": "1.0.0",
  "private": true,
  "description": "TPCS shared types, constants and mongoose models",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "mongoose": "^8.5.1"
  },
  "devDependencies": {
    "typescript": "^5.5.0"
  }
}
